# Public values: safe in the browser. Copy to .env.local (ignored by git) or set them in your web host.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Optional: remote WebSocket URL for live telemetry (e.g. wss://rivet-api.onrender.com/ws)
# NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com/ws
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
# Where the API lives (the Next.js proxy forwards /api here).
API_URL=http://127.0.0.1:8000

